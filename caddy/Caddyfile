:80 {
	# HTTP Basic Auth - browser akan tampilkan popup login
	basic_auth {
		{$CADDY_AUTH_USER:admin} {$CADDY_AUTH_HASH:$2a$14$VgTeZHXpe2NwUHijZIZOzeP3WkNOB6XvDYbYv0X8kjVbf6US9kfdq}
	}

	# Serve files with directory browsing (handle_path otomatis strip /files prefix)
	handle_path /files/* {
		root * /data/exports
		file_server browse

		# Content-Type overrides
		@xlsx path *.xlsx
		header @xlsx Content-Type "application/vnd.openxmlformats-officedocument.spreadsheetml.sheet"
		header @xlsx Content-Disposition "attachment"

		@parquet path *.parquet
		header @parquet Content-Type "application/octet-stream"
		header @parquet Content-Disposition "attachment"

		@json path *.json
		header @json Content-Type "application/json"
	}

	# Redirect /files to /files/
	redir /files /files/ permanent

	# Reject anything not under /files/
	handle {
		respond "Not Found" 404
	}

	log {
		output stdout
		format console
	}
}
