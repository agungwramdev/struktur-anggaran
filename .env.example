# JWT Configuration
JWT_SECRET=CHANGE_THIS_TO_A_SECURE_RANDOM_STRING
JWT_EXPIRATION=7d

# External API Credentials (data.pbj.my.id)
PBJ_API_USERNAME=your_username_here
PBJ_API_PASSWORD=your_password_here

# Security Settings - Rate Limiting
THROTTLE_TTL=60000
THROTTLE_LIMIT=10
LOGIN_THROTTLE_LIMIT=5

# Frontend Configuration
# For local development: http://localhost:4001
# For production with reverse proxy: /api (relative path)
NEXT_PUBLIC_API_URL=/api
FRONTEND_URL=https://struktur-anggaran.pbj.my.id
